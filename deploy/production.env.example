# CNB deployment variables
DEPLOY_ENABLED=true
DEPLOY_HOST=your-server-ip
DEPLOY_PORT=22
DEPLOY_USER=ubuntu
APP_DIR=/opt/ai-town
VITE_API_BASE_URL=/api
VITE_ASSET_BASE_URL=https://your-bucket.oss-cn-region.aliyuncs.com/assets/files

# Store this as a CNB secret, not in git.
SSH_PRIVATE_KEY=
SSH_KNOWN_HOSTS=

# Server-side backend environment, stored on the server at:
# /opt/ai-town/shared/backend.env
LLM_MODEL_ID=Qwen/Qwen2.5-72B-Instruct
LLM_API_KEY=
LLM_BASE_URL=https://api-inference.modelscope.cn/v1/
