# CNB 部署变量示例。
# 这个文件只作为 CNB 密钥仓库配置清单，不要填写真实密钥后提交到 Git。

DEPLOY_ENABLED=true
DEPLOY_HOST=your-server-ip
DEPLOY_PORT=22
DEPLOY_USER=root
APP_DIR=/opt/ai-town
PYTHON_BIN=/usr/bin/python3.12

VITE_API_BASE_URL=/api
VITE_ASSET_BASE_URL=/assets/files

# 这些值必须放在 CNB 密钥仓库，不要提交到主仓库。
SSH_PRIVATE_KEY=
SSH_KNOWN_HOSTS=

# 阿里云 RAM 用户凭证，用于部署时临时放行 CNB Runner 的 SSH 访问。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_REGION_ID=cn-hangzhou
ALIBABA_CLOUD_SECURITY_GROUP_ID=
ALIYUN_SECURITY_GROUP_PROPAGATION_SECONDS=8

# 这些变量最终会写入服务器：
# /opt/ai-town/shared/backend.env
LLM_MODEL_ID=qwen-plus
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=hello_agents_vectors
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT=30

EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=text-embedding-v3
EMBED_API_KEY=
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
